{
    "name": "@spacekit/wcvm-sdk",
    "version": "1.0.0",
    "description": "SpaceKit WebAssembly Compute Virtual Machine SDK for JavaScript/TypeScript",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "keywords": [
      "spacekit",
      "wcvm",
      "webassembly",
      "blockchain",
      "compute",
      "gpu",  
      "smart-contracts"
    ],
    "author": "SpaceKit Team",
    "license": "MIT",
    "homepage": "https://spacekit.xyz",
    "repository": {
      "type": "git",
      "url": "https://github.com/spacekit-xyz/wcvm-sdk-js.git"
    },
    "bugs": {
      "url": "https://github.com/spacekit-xyz/wcvm-sdk-js/issues"
    },
    "engines": {
      "node": ">=16.0.0"
    },
    "scripts": {
      "build": "tsc && rollup -c",
      "test": "jest",
      "test:watch": "jest --watch",
      "lint": "eslint src --ext .ts",
      "format": "prettier --write src/**/*.ts",
      "docs": "typedoc src/index.ts",
      "prepublishOnly": "npm run build && npm test",
      "example:deploy": "ts-node examples/deploy-contract.ts",
      "example:interact": "ts-node examples/interact-contract.ts",
      "example:gpu": "ts-node examples/gpu-compute.ts"
    },
    "dependencies": {
      "cross-fetch": "^3.1.5",
      "eventemitter3": "^4.0.7",
      "ws": "^8.13.0"
    },
    "devDependencies": {
      "@rollup/plugin-commonjs": "^24.1.0",
      "@rollup/plugin-node-resolve": "^15.0.2",
      "@rollup/plugin-typescript": "^11.1.0",
      "@types/jest": "^29.5.1",
      "@types/node": "^18.16.3",
      "@types/ws": "^8.5.4",
      "@typescript-eslint/eslint-plugin": "^5.59.2",
      "@typescript-eslint/parser": "^5.59.2",
      "eslint": "^8.40.0",
      "jest": "^29.5.0",
      "prettier": "^2.8.8",
      "rollup": "^3.21.6",
      "ts-jest": "^29.1.0",
      "ts-node": "^10.9.1",
      "typedoc": "^0.24.7",
      "typescript": "^5.0.4"
    },
    "files": [
      "dist/**/*",
      "README.md",
      "LICENSE"
    ],
    "publishConfig": {
      "access": "public"
    },
    "jest": {
      "preset": "ts-jest",
      "testEnvironment": "node",
      "roots": ["<rootDir>/src", "<rootDir>/test"],
      "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
      "collectCoverageFrom": [
        "src/**/*.ts",
        "!src/**/*.d.ts"
      ]
    },
    "bin": {
      "spacekitvm": "./bin/spacekitvm-cli.js"
    }
  }