{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacekit.xyz/schema/network-manifest-v1.schema.json",
  "title": "SpaceKit Network Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "network_id", "profile", "chain_id", "protocol", "genesis", "bootstrap", "roles"],
  "properties": {
    "version": { "const": 1 },
    "network_id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "profile": { "enum": ["private", "public"] },
    "chain_id": { "type": "integer", "minimum": 0 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "spacekit" },
        "version": { "const": 1 }
      }
    },
    "genesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "document"],
      "properties": {
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "uri": { "type": "string", "minLength": 1 },
        "document": {}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p2p", "rpc"],
      "properties": {
        "p2p": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rpc": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["subscriber", "operator", "validator"] }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["did", "roles"],
        "properties": {
          "did": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["subscriber", "operator", "validator"] }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "key_id", "public_key", "signature"],
      "properties": {
        "algorithm": { "const": "sphincs128f" },
        "encoding": { "enum": ["hex", "base64"] },
        "key_id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "public_key": { "type": "string", "minLength": 2 },
        "signature": { "type": "string", "minLength": 44 },
        "signed_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "public" } } },
      "then": {
        "required": ["signature"],
        "properties": {
          "bootstrap": {
            "properties": { "rpc": { "minItems": 1 } }
          }
        }
      }
    }
  ]
}
