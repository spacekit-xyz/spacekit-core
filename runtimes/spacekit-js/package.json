{
    "name": "@spacekit/spacekit-js",
    "version": "1.0.0",
    "description": "Multi-runtime WASM VM for SpaceKit smart contracts with JSON-RPC, EIP-1193, and P2P sync (browser, Node.js, Bun)",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "bun": "./dist/index.js",
        "node": "./dist/index.js",
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./vm": {
        "import": "./dist/vm/spacekitvm.js",
        "types": "./dist/vm/spacekitvm.d.ts"
      },
      "./storage": {
        "import": "./dist/storage.js",
        "types": "./dist/storage.d.ts"
      },
      "./contracts": {
        "import": "./dist/contracts/index.js",
        "types": "./dist/contracts/index.d.ts"
      },
      "./platform": {
        "import": "./dist/platform.js",
        "types": "./dist/platform.d.ts"
      },
      "./entry-node": {
        "node": "./dist/entry-node.js",
        "default": "./dist/entry-node.js"
      },
      "./entry-bun": {
        "bun": "./dist/entry-bun.js",
        "default": "./dist/entry-bun.js"
      },
      "./adapters": {
        "import": "./dist/vm/adapters/index.js",
        "types": "./dist/vm/adapters/index.d.ts"
      }
    },
    "bin": {
      "spacekit-node": "./dist/entry-node.js",
      "spacekit-bun": "./dist/entry-bun.js"
    },
    "files": [
        "dist",
        "growformer-pkg",
        "README.md",
        "LICENSE"
    ],
    "license": "MIT",
    "author": "SpaceKit Team",
    "repository": {
      "type": "git",
      "url": "https://github.com/spacekit-xyz/spacekit-js"
    },
    "homepage": "https://spacekit.xyz",
    "bugs": {
      "url": "https://github.com/spacekit-xyz/spacekit-js/issues"
    },
    "engines": {
      "node": ">=18.0.0"
    },
    "keywords": [
      "spacekit",
      "blockchain",
      "wasm",
      "smart-contracts",
      "vm",
      "eip-1193",
      "json-rpc",
      "p2p",
      "web3"
    ],
    "dependencies": {
      "@mlc-ai/web-llm": "^0.2.80",
      "@noble/ed25519": "^2.3.0",
      "@noble/hashes": "^1.5.0",
      "buffer": "^6.0.3",
      "wasm-metering": "^0.2.1"
    },
    "optionalDependencies": {
      "fake-indexeddb": "^6.0.0",
      "viem": "^2.21.0",
      "@solana/web3.js": "^1.95.0"
    },
    "scripts": {
        "build:quantum-verkle-wasm": "bash scripts/build-quantum-verkle-wasm.sh",
        "build:growformer-wasm": "bash scripts/build-growformer-wasm.sh",
      "build": "tsc -p tsconfig.json && npm run copy:assets",
      "copy:assets": "mkdir -p dist/wasm",
      "typecheck": "tsc -p tsconfig.json --noEmit",
      "test": "tsc -p tsconfig.json && node --test dist/*.test.js dist/spacetime/*.test.js dist/vm/*.test.js",
      "pq:wasm": "bash scripts/build-sphincs-wasm.sh",
      "prepublishOnly": "npm run build",
      "start": "npm run build && node dist/entry-node.js",
      "start:node": "npm run build && node dist/entry-node.js",
      "start:node:dev": "npm run build && node dist/entry-node.js --dev-mode true",
      "start:bun": "npm run build && bun dist/entry-bun.js",
      "start:bun:dev": "npm run build && bun dist/entry-bun.js --dev-mode true",
      "start:bun:native": "npm run build && bun dist/entry-bun.js --use-bun-serve true",
      "deploy:browser": "npm run build",
      "deploy:node": "npm run build && echo 'Run: node dist/entry-node.js'",
      "deploy:bun": "npm run build && echo 'Run: bun dist/entry-bun.js'",
      "proof-bridge-service": "npm run build && node dist/scripts/proof_bridge_service.js"
    },
    "peerDependencies": {
      "react": ">=18.0.0",
      "react-dom": ">=18.0.0"
    },
    "peerDependenciesMeta": {
      "react": {
        "optional": false
      },
      "react-dom": {
        "optional": false
      }
    },
    "devDependencies": {
      "@types/node": "^20.15.0",
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "typescript": "^5.5.4"
    }
}